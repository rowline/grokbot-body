{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grokbot-body",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "durable_objects": {
    "bindings": [
      { "name": "BODY", "class_name": "BodyDurableObject" },
      { "name": "PAIRING", "class_name": "PairingIndex" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BodyDurableObject", "PairingIndex"]
    }
  ]
}
